# Copier en .env et remplir. Ne jamais committer le .env.

# Django
DJANGO_SECRET_KEY=a-remplacer-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=trahay.nohost.me,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://trahay.nohost.me

# PostgreSQL (utilisé par les conteneurs postgres et web)
POSTGRES_DB=zytholog
POSTGRES_USER=zytholog
POSTGRES_PASSWORD=a-remplacer

# Déploiement
ZYTHOLOG_PORT=9003
ZYTHOLOG_PATH=/zytholog
